# Browser-safe Supabase values for the Next.js app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server/GitHub Actions only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Flow mode (Artifact-style guided pages). Set to 1 to enable the /flow route; the old /learn route is never touched.
NEXT_PUBLIC_FLOW_MODE=0
